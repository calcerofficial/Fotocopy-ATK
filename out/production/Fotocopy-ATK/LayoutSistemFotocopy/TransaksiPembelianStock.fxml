<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="1024.0" prefWidth="1280.0" stylesheets="@../css/TranskasiPembelianStock.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SistemFotocopy.PembelianStock">

    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <content>
                <VBox spacing="0.0" styleClass="content-wrapper">
                    <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="24.0" />
                    </padding>

                    <!-- ===================== TOP INFO BAR ===================== -->
                    <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-info-bar">
                        <children>
                            <!-- ID Pembelian -->
                            <VBox spacing="4.0">
                                <Label styleClass="info-label" text="ID PEMBELIAN" />
                                <TextField fx:id="txtIdPembelian" editable="false" prefWidth="120.0" styleClass="info-field-disabled" />
                            </VBox>

                            <!-- ID Pegawai -->
                            <VBox spacing="4.0">
                                <Label styleClass="info-label" text="ID PEGAWAI" />
                                <TextField fx:id="txtIdPegawai" editable="false" prefWidth="120.0" styleClass="info-field-disabled" />
                            </VBox>

                            <!-- Tanggal -->
                            <VBox spacing="4.0">
                                <Label styleClass="info-label" text="TANGGAL" />
                                <TextField fx:id="txtTanggal" editable="false" prefWidth="120.0" styleClass="info-field-disabled" />
                            </VBox>

                            <!-- Supplier -->
                            <VBox spacing="4.0">
                                <Label styleClass="info-label" text="SUPPLIER" />
                                <ComboBox fx:id="cbSupplier" prefWidth="180.0" promptText="Pilih Supplier..." />
                            </VBox>

                            <Region HBox.hgrow="ALWAYS" />
                        </children>
                    </HBox>

                    <!-- ===================== MAIN CONTENT - 2 COLUMN LAYOUT ===================== -->
                    <HBox spacing="24.0" styleClass="main-content" VBox.vgrow="ALWAYS">

                        <!-- ===== LEFT PANEL: DAFTAR KATALOG STOK ===== -->
                        <VBox styleClass="table-panel" HBox.hgrow="ALWAYS">

                            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="table-header">
                                <Label styleClass="table-title" text="DAFTAR KATALOG STOK" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="filter-bar">
                                <children>
                                    <Label styleClass="search-icon" text="🔍" />
                                    <HBox alignment="CENTER_LEFT" prefHeight="57.0" prefWidth="725.0" styleClass="topbar">
                                        <TextField fx:id="txtCari" prefWidth="981.0" promptText="Cari..." styleClass="topbar-search" HBox.hgrow="ALWAYS" />
                                    </HBox>
                                </children>
                            </HBox>

                            <!-- Table -->
                            <TableView fx:id="tblKatalog" styleClass="table-katalog" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colNamaBarang" prefWidth="220.0" text="NAMA BARANG" />
                                    <TableColumn fx:id="colMerkBarang" prefWidth="160.0" text="MERK BARANG" />
                                    <TableColumn fx:id="colHarga" prefWidth="140.0" text="HARGA" />
                                    <TableColumn fx:id="colAksi" prefWidth="80.0" text="AKSI" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>

                            <HBox alignment="CENTER_LEFT" styleClass="pagination-bar">
                                <Label fx:id="lblInfoData" styleClass="pagination-info" text="Menampilkan 0 dari 0 data" />
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER" spacing="8.0">
                                    <Button fx:id="btnPrevPage" styleClass="pagination-btn" text="‹" />
                                    <Button fx:id="btnPage1" styleClass="pagination-btn-active" text="1" />
                                    <Button fx:id="btnNextPage" styleClass="pagination-btn" text="›" />
                                </HBox>
                            </HBox>

                        </VBox>

                        <!-- ===== RIGHT PANEL: DETAIL PEMBELIAN ===== -->
                        <VBox prefWidth="370.0" styleClass="detail-panel">

                            <VBox spacing="4.0" styleClass="detail-header">
                                <Label styleClass="detail-title" text="Detail Pembelian Stock" />
                                <Label styleClass="detail-subtitle" text="DAFTAR PEMBELIAN" />
                            </VBox>

                            <ScrollPane fitToWidth="true" styleClass="items-scroll" VBox.vgrow="ALWAYS">
                                <content>
                                    <VBox fx:id="vboxItems" spacing="8.0" styleClass="items-list" />
                                </content>
                            </ScrollPane>

                            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="total-row">
                                <Label styleClass="total-label" text="Total Harga" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotalHarga" styleClass="total-value" text="Rp. 0" />
                            </HBox>

                            <VBox spacing="6.0" styleClass="note-section" />

                            <VBox styleClass="pay-section">
                                <Button fx:id="btnBayar" maxWidth="Infinity" onAction="#handleBayar" styleClass="btn-pay" text="Bayar" />
                            </VBox>

                        </VBox>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>