<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane prefHeight="1024.0" prefWidth="1280.0" style="-fx-background-color: #F8F9FB;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SistemFotocopy.MenuLogin">

    <stylesheets>
        <URL value="@../css/MenuLogin.css" />
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64.0" style="-fx-background-color: rgba(248, 249, 251, 0.8); -fx-border-color: #C3C6D6; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="40.0" right="40.0" />
            </padding>
            <children>
                <Label style="-fx-font-family: 'Hanken Grotesk'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #003D9B;" text="CopyStream Pro" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="24.0">
                    <children>
                        <Label style="-fx-font-family: 'Hanken Grotesk'; -fx-font-size: 16px; -fx-text-fill: #003D9B; -fx-border-color: #003D9B; -fx-border-width: 0 0 2 0;" text="Login" />
                        <Label style="-fx-font-family: 'Hanken Grotesk'; -fx-font-size: 16px; -fx-text-fill: #535F70;" text="Support" />
                        <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #E7E8EA; -fx-background-radius: 12px;">
                            <padding>
                                <Insets bottom="4.0" left="12.0" right="12.0" top="4.0" />
                            </padding>
                            <children>
                                <Circle fill="#22c55e" radius="4.0" stroke="TRANSPARENT" />
                                <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #191C1E;" text="SERVICE STATUS" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </HBox>
    </top>

    <center>
        <StackPane BorderPane.alignment="CENTER">
            <children>
                <VBox alignment="TOP_CENTER" maxHeight="500.0" maxWidth="360.0" prefHeight="500.0" prefWidth="360.0" spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 8px; -fx-border-color: #E1E4E8; -fx-border-width: 1px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.03), 10, 0, 0, 4);">
                    <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                    </padding>
                    <children>
                        <VBox alignment="CENTER" spacing="8.0">
                            <children>
                                <StackPane maxHeight="40.0" maxWidth="40.0" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: #003D9B; -fx-background-radius: 8px;">
                                    <children>
                                        <SVGPath content="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z" fill="WHITE" scaleX="0.9" scaleY="0.9" />
                                    </children>
                                </StackPane>
                                <Label style="-fx-font-family: 'Hanken Grotesk'; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #191C1E;" text="Welcome " />
                                <Label alignment="CENTER" style="-fx-font-family: 'Hanken Grotesk'; -fx-font-size: 12px; -fx-text-fill: #535F70;" text="Log in to manage your document pipeline." textAlignment="CENTER" wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="12.0">
                            <children>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #535F70;" text="Username" />
                                        <StackPane alignment="CENTER_LEFT">
                                            <children>
                                                <TextField fx:id="UserField" prefHeight="38.0" promptText="admin" style="-fx-padding: 0 12 0 38; -fx-background-color: white; -fx-border-color: #C3C6D6; -fx-border-radius: 6px;" styleClass="input-field" />
                                                <SVGPath content="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" fill="#718096" scaleX="0.75" scaleY="0.75">
                                                    <StackPane.margin>
                                                        <Insets left="12.0" />
                                                    </StackPane.margin>
                                                </SVGPath>
                                            </children>
                                        </StackPane>
                                        <Label fx:id="emailErrorLabel" managed="false" style="-fx-font-family: 'Hanken Grotesk'; -fx-font-size: 11px; -fx-text-fill: #E11D48; -fx-font-weight: bold;" text="Pesan Error Email" visible="false">
                                            <VBox.margin>
                                                <Insets left="2.0" top="2.0" />
                                            </VBox.margin>
                                        </Label>
                                    </children>
                                </VBox>

                                <VBox spacing="4.0">
                                    <children>
                                        <HBox alignment="BOTTOM_LEFT">
                                            <children>
                                                <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #535F70;" text="Password" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Hyperlink style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 10px; -fx-text-fill: #003D9B; -fx-underline: false; -fx-padding: 0;" text="Forgot Password?" />
                                            </children>
                                        </HBox>
                                        <StackPane alignment="CENTER_LEFT">
                                            <children>
                                                <TextField fx:id="passwordTextField" prefHeight="38.0" promptText="••••••••" style="-fx-padding: 0 38 0 38; -fx-background-color: white; -fx-border-color: #C3C6D6; -fx-border-radius: 6px;" visible="false" />

                                                <PasswordField fx:id="passwordField" prefHeight="38.0" promptText="••••••••" style="-fx-padding: 0 38 0 38; -fx-background-color: white; -fx-border-color: #C3C6D6; -fx-border-radius: 6px;" styleClass="input-field" />

                                                <SVGPath content="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" fill="#718096" scaleX="0.75" scaleY="0.75">
                                                    <StackPane.margin>
                                                        <Insets left="12.0" />
                                                    </StackPane.margin>
                                                </SVGPath>

                                                <HBox alignment="CENTER_RIGHT" maxHeight="38.0" maxWidth="36.0" onMouseClicked="#togglePasswordVisibility" style="-fx-cursor: hand;" StackPane.alignment="CENTER_RIGHT">
                                                    <children>
                                                        <SVGPath fx:id="IconMata" content="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" fill="#718096" onMouseClicked="#OnMouseKlikMata" scaleX="0.75" scaleY="0.75" />
                                                    </children>
                                                    <padding>
                                                        <Insets right="12.0" />
                                                    </padding>
                                                </HBox>
                                            </children>
                                        </StackPane>
                                        <Label fx:id="passwordErrorLabel" managed="false" style="-fx-font-family: 'Hanken Grotesk'; -fx-font-size: 11px; -fx-text-fill: #E11D48; -fx-font-weight: bold;" text="Pesan Error Password" visible="false">
                                            <VBox.margin>
                                                <Insets left="2.0" top="2.0" />
                                            </VBox.margin>
                                        </Label>
                                    </children>
                                </VBox>

                                <Region prefHeight="4.0" />

                                <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#OnactionLogin" prefHeight="38.0" style="-fx-background-color: #002D72; -fx-background-radius: 6px; -fx-cursor: hand;" styleClass="login-button">
                                    <graphic>
                                        <HBox alignment="CENTER" spacing="8.0">
                                            <children>
                                                <Label style="-fx-font-family: 'Hanken Grotesk'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;" text="Secure Login" />
                                                <SVGPath content="M16.01 11H4v2h12.01v3L20 12l-3.99-4v3z" fill="WHITE" scaleX="0.8" scaleY="0.8" />
                                            </children>
                                        </HBox>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" style="-fx-border-color: #E1E4E8; -fx-border-width: 1 0 0 0;" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets top="12.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER" spacing="4.0">
                                    <children>
                                        <Label style="-fx-font-family: 'Hanken Grotesk'; -fx-font-size: 12px; -fx-text-fill: #535F70;" text="New to CopyStream?" />
                                        <Hyperlink style="-fx-font-family: 'Hanken Grotesk'; -fx-font-size: 12px; -fx-text-fill: #003D9B; -fx-padding: 0;" text="Contact Sales" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="48.0" style="-fx-background-color: #F3F4F6; -fx-border-color: #C3C6D6; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="40.0" right="40.0" />
            </padding>
            <children>
                <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 12px; -fx-text-fill: #3B4858;" text="© 2024 CopyStream Solutions. All rights reserved." />
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="24.0">
                    <children>
                        <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 12px; -fx-text-fill: #3B4858;" text="Privacy Policy" />
                        <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 12px; -fx-text-fill: #3B4858;" text="Terms of Service" />
                        <Label style="-fx-font-family: 'JetBrains Mono'; -fx-font-size: 12px; -fx-text-fill: #3B4858;" text="Help Center" />
                    </children>
                </HBox>
            </children>
        </HBox>
    </bottom>
</BorderPane>