<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane prefHeight="943.0" prefWidth="1280.0" styleClass="main-bg" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SistemFotocopy.TransaksiPenjualan">

    <stylesheets>
        <URL value="@../css/TransaksiPenjualan.css" />
    </stylesheets>

    <VBox layoutX="24.0" layoutY="24.0" spacing="24.0" AnchorPane.bottomAnchor="24.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="24.0">

        <!-- ===== HEADER ===== -->
        <HBox alignment="CENTER_LEFT" spacing="24.0">
            <VBox spacing="4.0">
                <Label styleClass="page-title" text="Transaksi Penjualan" />
                <Label styleClass="page-subtitle" text="Kelola transaksi harian dan inventaris penjualan toko." />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <!-- ===== CARDS ===== -->
        <HBox alignment="CENTER" spacing="24.0">
            <!-- Card 1: Total Penjualan -->
            <VBox spacing="16.0" styleClass="card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" fill="#00357F" scaleX="1.2" scaleY="1.2" />
                    <Label styleClass="badge" text="Harian" />
                </HBox>
                <VBox spacing="4.0">
                    <Label styleClass="card-label" text="TOTAL PENJUALAN" />
                    <Label fx:id="lblTotalPenjualan" styleClass="card-value" text="Rp 0" />
                </VBox>
            </VBox>

            <!-- Card 2: Total Transaksi -->
            <VBox spacing="16.0" styleClass="card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="#505F76" scaleX="1.2" scaleY="1.2" />
                    <Label styleClass="badge" text="Real-time" />
                </HBox>
                <VBox spacing="4.0">
                    <Label styleClass="card-label" text="TOTAL TRANSAKSI" />
                    <Label fx:id="lblTotalTransaksi" styleClass="card-value" text="0" />
                </VBox>
            </VBox>

            <!-- Card 3: Produk Terjual -->
            <VBox spacing="16.0" styleClass="card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <SVGPath content="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h10v2H4v-2z" fill="#131B2E" scaleX="1.2" scaleY="1.2" />
                    <Label styleClass="badge" text="Stok Keluar" />
                </HBox>
                <VBox spacing="4.0">
                    <Label styleClass="card-label" text="PRODUK TERJUAL" />
                    <Label fx:id="lblProdukTerjual" styleClass="card-value" text="0" />
                </VBox>
            </VBox>
        </HBox>

        <!-- ===== MAIN CONTENT ===== -->
        <HBox spacing="24.0">
            <!-- TABLE -->
            <VBox spacing="0.0" styleClass="panel-container" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="table-header">
                    <Label styleClass="table-title" text="DETAIL PENJUALAN" />
                    <Region HBox.hgrow="ALWAYS" />
                    <DatePicker fx:id="dpTanggal" promptText="Tanggal Penjualan" styleClass="date-picker-small" />
                </HBox>

                <TableView fx:id="tblPenjualan" styleClass="table-view" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdPenjualan" prefWidth="142.0" text="ID PENJUALAN" />
                        <TableColumn fx:id="colNamaBarang" prefWidth="236.0" text="NAMA PRODUK" />
                        <TableColumn fx:id="colJumlah" prefWidth="225.0" text="JUMLAH" />
                        <TableColumn fx:id="colHarga" prefWidth="162.0" text="HARGA SATUAN" />
                        <TableColumn fx:id="colAksi" prefWidth="159.0" text="AKSI" />
                    </columns>
                </TableView>

                <!-- Empty State -->
                <VBox fx:id="emptyState" alignment="CENTER" spacing="8.0" VBox.vgrow="ALWAYS">
                    <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" fill="#191C1E" opacity="0.4" scaleX="2.0" scaleY="2.0" />
                    <Label styleClass="empty-text" text="Belum ada item ditambahkan" />
                    <Label styleClass="empty-subtext" text="Pilih barang di panel samping untuk memulai" />
                </VBox>

                <!-- Footer -->
                <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="table-footer">
                    <HBox alignment="CENTER_LEFT" spacing="16.0">
                        <VBox spacing="4.0">
                            <Label styleClass="footer-label" text="Metode Pembayaran" />
                            <ComboBox fx:id="cbMetodePembayaran" styleClass="combo-box-small" />
                        </VBox>
                        <VBox spacing="4.0">
                            <Label styleClass="footer-label" text="Uang Bayar" />
                            <TextField fx:id="txtUangBayar" promptText="Masukan Uang Bayar" styleClass="text-field-small" />
                        </VBox>
                        <VBox spacing="4.0">
                            <Label styleClass="footer-label" text="Kembalian" />
                            <TextField fx:id="txtKembalian" styleClass="text-field-small" />
                        </VBox>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox alignment="CENTER_RIGHT" spacing="8.0">
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                            <Label styleClass="total-label" text="TOTAL HARGA" />
                            <Label fx:id="lblTotalHarga" styleClass="total-value" text="Rp 0" />
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <Button fx:id="btnBatal" styleClass="btn-outline" text="Batal" />
                            <Button fx:id="btnSimpan" styleClass="btn-primary" text="Simpan" />
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <!-- SIDEBAR INPUT -->
            <VBox maxWidth="320.0" minWidth="280.0" spacing="16.0" styleClass="sidebar-panel">
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="sidebar-header">
                    <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="#00357F" scaleX="1.2" scaleY="1.2" />
                    <Label styleClass="sidebar-title" text="Data Input" />
                </HBox>

                <VBox spacing="8.0">
                    <Label styleClass="input-label" text="ID PENJUALAN" />
                    <TextField fx:id="txtIdPenjualan" editable="false" styleClass="text-field-disabled" text="Auto-generated" />
                </VBox>

                <VBox spacing="8.0">
                    <Label styleClass="input-label" text="ID PEGAWAI" />
                    <TextField fx:id="txtIdPegawai" editable="false" styleClass="text-field-disabled" />
                </VBox>

                <VBox spacing="8.0">
                    <Label styleClass="input-label" text="Nama Layanan" />
                    <ComboBox fx:id="cbNamaLayanan" prefHeight="49.0" prefWidth="230.0" styleClass="combo-box" />
                </VBox>
                <VBox spacing="8.0">
                    <Label styleClass="input-label" text="Nama Barang" />
                    <ComboBox fx:id="cbNamaBarang" prefHeight="49.0" prefWidth="230.0" styleClass="combo-box" />
                </VBox>

                <VBox spacing="8.0">
                    <Label styleClass="input-label" text="JUMLAH" />
                    <TextField fx:id="txtJumlah" promptText="Masukan jumlah..." styleClass="text-field" />
                </VBox>

                <VBox spacing="12.0" styleClass="sidebar-actions">
                    <Button fx:id="btnTambah" styleClass="btn-primary-full" text="Tambah" />
                    <Button fx:id="btnBatalSidebar" styleClass="btn-outline-full" text="Batal" />
                </VBox>
            </VBox>
        </HBox>

    </VBox>

</AnchorPane>
