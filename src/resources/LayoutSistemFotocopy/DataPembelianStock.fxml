<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane styleClass="data-pembelian-bg" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SistemFotocopy.Transaksi.TransaksiPembelianStok.LihatDataDanDetail.Controller.DataPembelianStock">

    <stylesheets>
        <URL value="@../css/DataPembelianStock.css" />
    </stylesheets>

    <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="scroll-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <content>
            <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="data-pembelian-container">
                <padding>
                    <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                </padding>

                <children>
                    <!-- ===== HEADER SECTION ===== -->
                    <HBox alignment="CENTER_LEFT" styleClass="header-section">
                        <children>
                            <!-- Icon Shopping Cart -->
                            <StackPane styleClass="header-icon-bg">
                                <children>
                                    <SVGPath content="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0 0 20 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z" styleClass="header-icon-svg" />
                                </children>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="3.0">
                                <HBox.margin><Insets left="12.0" /></HBox.margin>
                                <children>
                                    <Label styleClass="header-title" text="Data Pembelian Stock" />
                                    <Label styleClass="header-subtitle" text="Kelola riwayat dan transaksi pembelian stock dari supplier." />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- ===== STATS CARDS ===== -->
                    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="stats-row">
                        <children>
                            <!-- Card 1: Total Transaksi -->
                            <VBox spacing="10.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <StackPane styleClass="stat-icon-wrap-blue">
                                                <SVGPath content="M19 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" styleClass="stat-icon-svg-white" />
                                            </StackPane>
                                            <Label styleClass="stat-label" text="TOTAL TRANSAKSI" />
                                        </children>
                                    </HBox>
                                    <Label fx:id="lblTotalTransaksi" styleClass="stat-value-blue" text="0" />
                                </children>
                            </VBox>

                            <!-- Card 2: Lunas -->
                            <VBox spacing="10.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <StackPane styleClass="stat-icon-wrap-green">
                                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" styleClass="stat-icon-svg-white" />
                                            </StackPane>
                                            <Label styleClass="stat-label" text="TRANSAKSI LUNAS" />
                                        </children>
                                    </HBox>
                                    <Label fx:id="lblLunas" styleClass="stat-value-green" text="0" />
                                </children>
                            </VBox>

                            <!-- Card 3: Belum Lunas -->
                            <VBox spacing="10.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <StackPane styleClass="stat-icon-wrap-red">
                                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" styleClass="stat-icon-svg-white" />
                                            </StackPane>
                                            <Label styleClass="stat-label" text="BELUM LUNAS" />
                                        </children>
                                    </HBox>
                                    <Label fx:id="lblBelumLunas" styleClass="stat-value-red" text="0" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- ===== MAIN CONTENT: FORM + TABLE ===== -->
                    <HBox alignment="TOP_LEFT" spacing="20.0" styleClass="main-content">
                        <children>

                            <!-- ===== TABLE SECTION (KANAN) ===== -->
                            <VBox alignment="TOP_CENTER" spacing="16.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <!-- ===== TABLE DATA PEMBELIAN ===== -->
                                    <VBox alignment="CENTER_LEFT" spacing="0.0" styleClass="table-card">
                                        <children>
                                            <!-- Table Header Bar -->
                                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="table-card-header">
                                                <padding><Insets bottom="14.0" left="20.0" right="20.0" top="14.0" /></padding>
                                                <children>
                                                    <Label styleClass="table-card-title" text="Daftar Transaksi Pembelian" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <!-- Search Field -->
                                                    <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="search-box">
                                                        <children>
                                                            <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" styleClass="search-icon-svg" />
                                                            <TextField fx:id="txtCari" prefWidth="180.0" promptText="Cari ID/Supplier..." styleClass="search-field" />
                                                        </children>
                                                    </HBox>
                                                </children>
                                            </HBox>

                                            <!-- TableView -->
                                            <TableView fx:id="tablePembelian" prefHeight="400.0" styleClass="mesin-table" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colIdPembelian" prefWidth="100.0" text="ID Transaksi" />
                                                    <TableColumn fx:id="colPegawai" prefWidth="100.0" text="ID Pegawai" />
                                                    <TableColumn fx:id="colSupplier" prefWidth="120.0" text="Supplier" />
                                                    <TableColumn fx:id="colTanggal" prefWidth="120.0" text="Tanggal" />
                                                    <TableColumn fx:id="colMetode" prefWidth="110.0" text="Metode" />
                                                    <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total Harga" />
                                                    <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" />

                                                    <!-- ===== COLOM AKSI ===== -->
                                                    <TableColumn fx:id="colAksi" prefWidth="100.0" styleClass="col-aksi" text="Aksi">
                                                        <graphic>
                                                            <Label styleClass="col-aksi-header" />
                                                        </graphic>
                                                    </TableColumn>
                                                </columns>
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                </columnResizePolicy>
                                            </TableView>

                                            <!-- Table Footer with Pagination -->
                                            <HBox alignment="CENTER_LEFT" styleClass="table-card-footer">
                                                <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
                                                <children>
                                                    <!-- Info text kiri -->
                                                    <SVGPath content="M11 17h2v-6h-2v6zm1-15C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zM11 9h2V7h-2v2z" styleClass="footer-icon-svg" />
                                                    <Label fx:id="lblInfoData" styleClass="table-footer-text" text="Menampilkan 0 dari 0 data">
                                                        <HBox.margin><Insets left="6.0" /></HBox.margin>
                                                    </Label>

                                                    <Region HBox.hgrow="ALWAYS" />

                                                    <!-- Pagination controls kanan -->
                                                    <HBox alignment="CENTER" spacing="6.0" styleClass="pagination-row">
                                                        <children>
                                                            <!-- Tombol Prev -->
                                                            <Button fx:id="btnPrev" styleClass="pagination-btn" text="">
                                                                <graphic>
                                                                    <SVGPath content="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" styleClass="pagination-icon-svg" />
                                                                </graphic>
                                                            </Button>

                                                            <!-- Page number display -->
                                                            <HBox alignment="CENTER" spacing="4.0" styleClass="pagination-pages">
                                                                <children>
                                                                    <Label fx:id="lblPageInfo" styleClass="pagination-page-info" text="Hal 1 / 1" />
                                                                </children>
                                                            </HBox>

                                                            <!-- Tombol Next -->
                                                            <Button fx:id="btnNext" styleClass="pagination-btn" text="">
                                                                <graphic>
                                                                    <SVGPath content="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" styleClass="pagination-icon-svg" />
                                                                </graphic>
                                                            </Button>
                                                        </children>
                                                    </HBox>
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>
