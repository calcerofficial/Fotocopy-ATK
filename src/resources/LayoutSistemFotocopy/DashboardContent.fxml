<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SistemFotocopy.Dashboard">

    <stylesheets>
        <URL value="@../css/MenuDashboard.css" />
    </stylesheets>

    <content>
        <VBox spacing="24.0" styleClass="main-bg">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
            </padding>
            <children>
                <HBox spacing="16.0">
                    <children>
                        <VBox spacing="12.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                            <children>
                                <HBox alignment="TOP_RIGHT">
                                    <children>
                                        <SVGPath content="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5 .67 1.5 1.5-.67 1.5-1.5 1.5z" fill="#002F6B" scaleX="1.2" scaleY="1.2" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="badge-green" text="+0%" />
                                    </children>
                                </HBox>
                                <Label styleClass="card-title" text="SALDO KAS" />
                                <Label fx:id="HasilSaldo" styleClass="card-value" text="Rp. -" />
                            </children>
                        </VBox>

                        <VBox spacing="12.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                            <children>
                                <HBox alignment="TOP_RIGHT">
                                    <children>
                                        <SVGPath content="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-5 10H9v2H7v-2H6v-2h1v-2H6V8h1V6h2v2h6V6h2v2h1v2h-1v2h1v2h-2v-2zm-4-4v2h4v-2h-4z" fill="#002F6B" scaleX="1.2" scaleY="1.2" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="badge-green" text="+0%" />
                                    </children>
                                </HBox>
                                <Label styleClass="card-title" text="PENDAPATAN" />
                                <Label fx:id="HasilPendapat" styleClass="card-value" text="Rp. -" />
                            </children>
                        </VBox>

                        <VBox spacing="12.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                            <children>
                                <HBox alignment="TOP_RIGHT">
                                    <children>
                                        <SVGPath content="M12.71 2.29c-.39-.39-1.02-.39-1.41 0L4.22 9.36c-.39.39-.39 1.02 0 1.41l7.07 7.07c.39.39 1.02.39 1.41 0l7.07-7.07c.39-.39.39-1.02 0-1.41L12.71 2.29zM12 11c-.55 0-1-.45-1-1S11.45 9 12 9s1 .45 1 1-.45 1-1 1z" fill="#BA1A1A" scaleX="1.2" scaleY="1.2" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="badge-red" text="-0%" />
                                    </children>
                                </HBox>
                                <Label styleClass="card-title" text="PENGELUARAN" />
                                <Label fx:id="HasilPengeluaran" styleClass="card-value-red" text="Rp. -" />
                            </children>
                        </VBox>

                        <VBox spacing="12.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                            <children>
                                <HBox alignment="TOP_RIGHT">
                                    <children>
                                        <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 1.34 5 3s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="#002F6B" scaleX="1.2" scaleY="1.2" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="badge-gray" text="Stable" />
                                    </children>
                                </HBox>
                                <Label styleClass="card-title" text="KARYAWAN AKTIF" />
                                <Label fx:id="HasilKaryawanAktif" styleClass="card-value" text="0" />
                            </children>
                        </VBox>

                        <VBox spacing="12.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                            <children>
                                <HBox alignment="TOP_RIGHT">
                                    <children>
                                        <SVGPath content="M3 3v18h18V3H3zm16 16H5V5h14v14zM17 7H7v2h10V7zm0 4H7v2h10v-2zm0 4H7v2h10v-2z" fill="#BA1A1A" scaleX="1.2" scaleY="1.2" />
                                    </children>
                                </HBox>
                                <Label styleClass="card-title" text="KETERSEDIAAN STOK" />
                                <HBox alignment="BOTTOM_LEFT" spacing="6.0">
                                    <children>
                                        <Label fx:id="HasilStock" styleClass="card-value" text="0%" />
                                        <Label styleClass="text-muted-hanken" text="kapasitas" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="24.0">
                    <children>
                        <VBox spacing="24.0" styleClass="summary-card" HBox.hgrow="ALWAYS">
                            <padding><Insets bottom="32.0" left="32.0" right="32.0" top="32.0" /></padding>
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label styleClass="chart-main-title" text="Grafik Penjualan Bulanan" />
                                                <Label styleClass="chart-sub-title" text="Visualisasi Total Transaksi Penjualan Jasa Fotokopi dan ATK" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <BarChart fx:id="salesBarChart" legendVisible="false" prefHeight="256.0">
                                    <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
                                    <yAxis><NumberAxis side="LEFT" /></yAxis>
                                </BarChart>

                                <HBox spacing="40.0" styleClass="border-top-divider">
                                    <padding><Insets top="24.0" /></padding>
                                    <children>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label styleClass="text-muted-mono" text="TOTAL OMSET BULAN INI" />
                                                <HBox alignment="BOTTOM_LEFT" spacing="4.0">
                                                    <children>
                                                        <Label fx:id="TotalOmsetBulan" styleClass="bottom-info-value" text="Rp. -" />
                                                        <Label styleClass="text-green-hanken" text="/ Bulan" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label styleClass="text-muted-mono" text="PERSENTASE KEUNTUNGAN" />
                                                <Label fx:id="PrestaseKeuntungan" styleClass="bottom-info-value" text="0%" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox prefWidth="285.0" styleClass="stock-card">
                            <children>
                                <Label styleClass="stock-main-title" text="View Barang">
                                    <padding><Insets bottom="24.0" left="32.0" right="32.0" top="24.0" /></padding>
                                </Label>

                                <TableView fx:id="miniStockTable" prefHeight="200.0" styleClass="mini-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colMiniBarang" prefWidth="160.0" text="BARANG" />
                                        <TableColumn fx:id="colMiniStock" prefWidth="75.0" text="STOCK" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                    <VBox.margin>
                                        <Insets left="16.0" right="16.0" />
                                    </VBox.margin>
                                </TableView>

                                <Region prefHeight="20.0" />

                                <HBox alignment="CENTER_LEFT" styleClass="stock-footer">
                                    <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
                                    <children>
                                        <Label styleClass="text-muted-mono-bold" text="STATUS: AMAN" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <HBox spacing="4.0">
                                            <children>
                                                <Rectangle fill="#4ADE80" height="12.0" width="4.0" />
                                                <Rectangle fill="#4ADE80" height="12.0" width="4.0" />
                                                <Rectangle fill="#4ADE80" height="12.0" width="4.0" />
                                                <Rectangle fill="#4ADE80" height="12.0" width="4.0" />
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
