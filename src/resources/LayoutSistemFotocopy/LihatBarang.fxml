<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="1355.0" prefWidth="1280.0" styleClass="root-bg" stylesheets="@../css/DataProduk.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SistemFotocopy.LihatDataProduk.Controller.LihatBarang">

    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <content>
                <VBox spacing="24.0" styleClass="content-wrapper">
                    <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
                    </padding>

                    <!-- ===================== HEADER + STAT CARDS ===================== -->
                    <VBox spacing="32.0" styleClass="card-panel">
                        <Label styleClass="page-title" text="Data Barang" />

                        <HBox spacing="24.0">
                            <!-- Total Produk -->
                            <HBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="stat-label" text="TOTAL Barang" />
                                    <Label fx:id="lblTotalProduk" styleClass="stat-value" text="0" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="stat-icon" text="📦" />
                            </HBox>

                            <!-- Produk Tersedia -->
                            <HBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="stat-label" text="BARANG TERSEDIA" />
                                    <Label fx:id="lblProdukTersedia" styleClass="stat-value" text="0" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="stat-icon" text="📚" />
                            </HBox>

                            <!-- Produk Tidak Tersedia -->
                            <HBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="stat-label" text="BARANG TIDAK TERSEDIA" />
                                    <Label fx:id="lblProdukTidakTersedia" styleClass="stat-value-dark" text="0" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="stat-icon-warning" text="⚠" />
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- ===================== TOMBOL AKSI + PENCARIAN ===================== -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <TextField fx:id="txtCari" prefWidth="1186.0" promptText="🔍 Cari Berdasarkan nama......" styleClass="search-field" />
                    </HBox>

                    <!-- ===================== TABEL DATA ===================== -->
                    <VBox styleClass="table-panel">
                        <TableView fx:id="tblProduk" styleClass="table-pegawai" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colIdBarang" prefWidth="120.0" text="ID BARANG" />
                                <TableColumn fx:id="colNamaBarang" prefWidth="150.0" text="NAMA BARANG" />
                                <TableColumn fx:id="colHarga" prefWidth="110.0" text="HARGA" />
                                <TableColumn fx:id="colStock" prefWidth="90.0" text="STOCK" />
                                <TableColumn fx:id="colMerkProduk" prefWidth="130.0" text="MERK" />
                                <TableColumn fx:id="colStatusProduk" prefWidth="120.0" text="STATUS " />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" styleClass="pagination-bar">
                            <Label fx:id="lblInfoData" styleClass="pagination-info" text="Menampilkan 0 dari 0 data" />
                            <Region HBox.hgrow="ALWAYS" />
                            <HBox alignment="CENTER" spacing="8.0">
                                <Button fx:id="btnPrevPage" styleClass="pagination-btn" text="&lt;" />
                                <Button fx:id="btnPage1" styleClass="pagination-btn-active" text="1" />
                                <Button fx:id="btnNextPage" styleClass="pagination-btn" text="&gt;" />
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- ===================== FOOTER ===================== -->
                    <AnchorPane styleClass="footer-panel">
                        <HBox alignment="CENTER_LEFT" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                            <Label styleClass="footer-copyright" text="© 2025 COPYSTREAM PROFESSIONAL SERVICES | ENTERPRISE BUILD V4.2.1" />
                            <Region HBox.hgrow="ALWAYS" />
                            <HBox spacing="24.0">
                                <Label styleClass="footer-link" text="PRIVACY PROTOCOL" />
                                <Label styleClass="footer-link" text="COMPLIANCE HUB" />
                                <Label styleClass="footer-link" text="SYSTEM SUPPORT" />
                            </HBox>
                        </HBox>
                    </AnchorPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
