<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane styleClass="data-mesin-bg" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SistemFotocopy.DataMesin">

    <stylesheets>
        <URL value="@../css/DataMesin.css" />
    </stylesheets>

    <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="scroll-pane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <content>
            <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="data-mesin-container">
                <padding>
                    <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                </padding>

                <children>
                    <!-- ===== HEADER SECTION ===== -->
                    <HBox alignment="CENTER_LEFT" styleClass="header-section">
                        <children>
                            <!-- Icon gear/mesin -->
                            <StackPane styleClass="header-icon-bg">
                                <children>
                                    <SVGPath content="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" styleClass="header-icon-svg" />
                                </children>
                            </StackPane>
                            <VBox alignment="CENTER_LEFT" spacing="3.0">
                                <HBox.margin><Insets left="12.0" /></HBox.margin>
                                <children>
                                    <Label styleClass="header-title" text="Data Mesin" />
                                    <Label styleClass="header-subtitle" text="Kelola data mesin fotocopy dan riwayat maintenance." />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- ===== STATS CARDS ===== -->
                    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="stats-row">
                        <children>
                            <!-- Card 1: Total Mesin -->
                            <VBox spacing="10.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <StackPane styleClass="stat-icon-wrap-blue">
                                                <SVGPath content="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-5 10H9v2H7v-2H6v-2h1v-2H6V8h1V6h2v2h6V6h2v2h1v2h-1v2h1v2h-2v-2zm-4-4v2h4v-2h-4z" styleClass="stat-icon-svg-white" />
                                            </StackPane>
                                            <Label styleClass="stat-label" text="TOTAL MESIN" />
                                        </children>
                                    </HBox>
                                    <Label fx:id="lblTotalMesin" styleClass="stat-value-blue" text="0" />
                                </children>
                            </VBox>

                            <!-- Card 2: Mesin Aktif -->
                            <VBox spacing="10.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <StackPane styleClass="stat-icon-wrap-green">
                                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" styleClass="stat-icon-svg-white" />
                                            </StackPane>
                                            <Label styleClass="stat-label" text="MESIN AKTIF" />
                                        </children>
                                    </HBox>
                                    <Label fx:id="lblMesinAktif" styleClass="stat-value-green" text="0" />
                                </children>
                            </VBox>

                            <!-- Card 3: Mesin Non Aktif -->
                            <VBox spacing="10.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <children>
                                            <StackPane styleClass="stat-icon-wrap-red">
                                                <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm5 11H7v-2h10v2z" styleClass="stat-icon-svg-white" />
                                            </StackPane>
                                            <Label styleClass="stat-label" text="NON AKTIF" />
                                        </children>
                                    </HBox>
                                    <Label fx:id="lblMesinNonAktif" styleClass="stat-value-red" text="0" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- ===== MAIN CONTENT: FORM + TABLE ===== -->
                    <HBox alignment="TOP_LEFT" spacing="20.0" styleClass="main-content">
                        <children>
                            <!-- ===== FORM SECTION (KIRI) ===== -->
                            <VBox alignment="TOP_LEFT" spacing="0.0" styleClass="form-card">
                                <children>
                                    <!-- Form Header -->
                                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="form-card-header">
                                        <padding><Insets bottom="16.0" left="20.0" right="20.0" top="16.0" /></padding>
                                        <children>
                                            <StackPane styleClass="form-header-icon-wrap">
                                                <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" styleClass="form-header-icon-svg" />
                                            </StackPane>
                                            <Label styleClass="form-card-title" text="Input Data Mesin" />
                                        </children>
                                    </HBox>

                                    <!-- Form Body -->
                                    <VBox spacing="16.0" styleClass="form-body">
                                        <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                        <children>
                                            <!-- ID Mesin -->
                                            <VBox spacing="6.0" styleClass="form-group">
                                                <children>
                                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                        <children>
                                                            <SVGPath content="M17.63 5.84C17.27 5.33 16.67 5 16 5L5 5.01C3.9 5.01 3 5.9 3 7v10c0 1.1.9 1.99 2 1.99L16 19c.67 0 1.27-.33 1.63-.84L22 12l-4.37-6.16z" styleClass="field-icon-svg" />
                                                            <Label styleClass="form-label" text="ID Mesin" />
                                                        </children>
                                                    </HBox>
                                                    <TextField fx:id="txtIdMesin" editable="false" styleClass="form-field-disabled" />
                                                    <Label styleClass="form-hint" text="ID di-isi otomatis oleh sistem" />
                                                </children>
                                            </VBox>

                                            <!-- Nama Mesin -->
                                            <VBox spacing="6.0" styleClass="form-group">
                                                <children>
                                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                        <children>
                                                            <SVGPath content="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-5 10H9v2H7v-2H6v-2h1v-2H6V8h1V6h2v2h6V6h2v2h1v2h-1v2h1v2h-2v-2zm-4-4v2h4v-2h-4z" styleClass="field-icon-svg" />
                                                            <Label styleClass="form-label" text="Nama Mesin" />
                                                        </children>
                                                    </HBox>
                                                    <TextField fx:id="txtNamaMesin" promptText="Masukkan nama mesin..." styleClass="form-field" />
                                                    <!-- ERROR LABEL NAMA MESIN -->
                                                    <Label fx:id="lblErrorNama" styleClass="error-label" managed="false" text="" visible="false" />
                                                </children>
                                            </VBox>

                                            <!-- Merk Mesin -->
                                            <VBox spacing="6.0" styleClass="form-group">
                                                <children>
                                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                                        <children>
                                                            <SVGPath content="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z" styleClass="field-icon-svg" />
                                                            <Label styleClass="form-label" text="Merk Mesin" />
                                                        </children>
                                                    </HBox>
                                                    <TextField fx:id="txtMerkMesin" promptText="Masukkan merk mesin..." styleClass="form-field" />
                                                    <!-- ERROR LABEL MERK MESIN -->
                                                    <Label fx:id="lblErrorMerk" styleClass="error-label" managed="false" text="" visible="false" />
                                                </children>
                                            </VBox>

                                            <!-- Divider -->
                                            <Region styleClass="form-divider" />

                                            <!-- Form Buttons -->
                                            <VBox spacing="8.0">
                                                <children>
                                                    <HBox spacing="8.0">
                                                        <children>
                                                            <Button fx:id="BrtSimpan" maxWidth="1.7976931348623157E308" onAction="#OnSimpan" styleClass="btn-simpan" text="Simpan" HBox.hgrow="ALWAYS">
                                                                <graphic>
                                                                    <SVGPath content="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" styleClass="btn-icon-svg" />
                                                                </graphic>
                                                            </Button>
                                                            <Button fx:id="BtUbah" maxWidth="1.7976931348623157E308" onAction="#OnUbah" styleClass="btn-ubah" text="Ubah" HBox.hgrow="ALWAYS">
                                                                <graphic>
                                                                    <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" styleClass="btn-icon-svg" />
                                                                </graphic>
                                                            </Button>
                                                        </children>
                                                    </HBox>
                                                    <HBox spacing="8.0">
                                                        <children>
                                                            <Button fx:id="BtHapus" maxWidth="1.7976931348623157E308" onAction="#OnHapus" styleClass="btn-hapus" text="Hapus" HBox.hgrow="ALWAYS">
                                                                <graphic>
                                                                    <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" styleClass="btn-icon-svg-red" />
                                                                </graphic>
                                                            </Button>
                                                            <Button fx:id="BtBatal" maxWidth="1.7976931348623157E308" onAction="#OnBatal" styleClass="btn-batal" text="Batal" HBox.hgrow="ALWAYS">
                                                                <graphic>
                                                                    <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" styleClass="btn-icon-svg" />
                                                                </graphic>
                                                            </Button>
                                                        </children>
                                                    </HBox>
                                                </children>
                                            </VBox>
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>

                            <!-- ===== TABLE + RIWAYAT SECTION (KANAN) ===== -->
                            <VBox alignment="TOP_CENTER" spacing="16.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <!-- ===== TABLE MESIN ===== -->
                                    <VBox alignment="CENTER_LEFT" spacing="0.0" styleClass="table-card">
                                        <children>
                                            <!-- Table Header Bar -->
                                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="table-card-header">
                                                <padding><Insets bottom="14.0" left="20.0" right="20.0" top="14.0" /></padding>
                                                <children>
                                                    <Label styleClass="table-card-title" text="Daftar Mesin" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <!-- Search Field -->
                                                    <HBox alignment="CENTER_LEFT" spacing="6.0" styleClass="search-box">
                                                        <children>
                                                            <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" styleClass="search-icon-svg" />
                                                            <TextField fx:id="txtCariMesin" prefWidth="180.0" promptText="Cari mesin..." styleClass="search-field" />
                                                        </children>
                                                    </HBox>
                                                </children>
                                            </HBox>

                                            <!-- TableView -->
                                            <TableView fx:id="tableMesin" prefHeight="260.0" styleClass="mesin-table" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colIdMesin" prefWidth="110.0" text="ID Mesin" />
                                                    <TableColumn fx:id="colNamaMesin" prefWidth="160.0" text="Nama Mesin" />
                                                    <TableColumn fx:id="colMerkMesin" prefWidth="160.0" text="Merk / Jenis" />
                                                    <TableColumn fx:id="colStatusMesin" prefWidth="110.0" text="Status" />
                                                </columns>
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                </columnResizePolicy>
                                            </TableView>

                                            <!-- Table Footer with Pagination -->
                                            <HBox alignment="CENTER_LEFT" styleClass="table-card-footer">
                                                <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
                                                <children>
                                                    <!-- Info text kiri -->
                                                    <SVGPath content="M11 17h2v-6h-2v6zm1-15C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zM11 9h2V7h-2v2z" styleClass="footer-icon-svg" />
                                                    <Label fx:id="lblInfoData" styleClass="table-footer-text" text="Menampilkan 0 dari 0 data">
                                                        <HBox.margin><Insets left="6.0" /></HBox.margin>
                                                    </Label>

                                                    <Region HBox.hgrow="ALWAYS" />

                                                    <!-- Pagination controls kanan -->
                                                    <HBox alignment="CENTER" spacing="6.0" styleClass="pagination-row">
                                                        <children>
                                                            <!-- Tombol Prev -->
                                                            <Button fx:id="btnPrev" onAction="#handlePrevPage" styleClass="pagination-btn" text="">
                                                                <graphic>
                                                                    <SVGPath content="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z" styleClass="pagination-icon-svg" />
                                                                </graphic>
                                                            </Button>

                                                            <!-- Page number display -->
                                                            <HBox alignment="CENTER" spacing="4.0" styleClass="pagination-pages">
                                                                <children>
                                                                    <Label fx:id="lblPageInfo" styleClass="pagination-page-info" text="Hal 1 / 1" />
                                                                </children>
                                                            </HBox>

                                                            <!-- Tombol Next -->
                                                            <Button fx:id="btnNext" onAction="#handleNextPage" styleClass="pagination-btn" text="">
                                                                <graphic>
                                                                    <SVGPath content="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z" styleClass="pagination-icon-svg" />
                                                                </graphic>
                                                            </Button>
                                                        </children>
                                                    </HBox>
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>

                                    <!-- ===== RIWAYAT MAINTENANCE ===== -->
                                    <VBox alignment="CENTER_LEFT" spacing="0.0" styleClass="riwayat-card">
                                        <children>
                                            <!-- Riwayat Header -->
                                            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="riwayat-card-header">
                                                <padding><Insets bottom="14.0" left="20.0" right="20.0" top="14.0" /></padding>
                                                <children>
                                                    <StackPane styleClass="riwayat-header-icon-wrap">
                                                        <SVGPath content="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z" styleClass="riwayat-header-icon-svg" />
                                                    </StackPane>
                                                    <Label styleClass="riwayat-card-title" text="Riwayat Maintenance" />
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <!-- Status badge -->
                                                    <HBox alignment="CENTER" spacing="6.0" styleClass="status-badge-aman">
                                                        <padding><Insets bottom="5.0" left="10.0" right="10.0" top="5.0" /></padding>
                                                        <children>
                                                            <Rectangle arcHeight="10.0" arcWidth="10.0" fill="#4ADE80" height="8.0" width="8.0" />
                                                            <Label styleClass="status-badge-text" text="AMAN" />
                                                        </children>
                                                    </HBox>
                                                </children>
                                            </HBox>

                                            <!-- Riwayat Table -->
                                            <TableView fx:id="tableRiwayat" prefHeight="200.0" styleClass="riwayat-table" VBox.vgrow="ALWAYS">
                                                <columns>
                                                    <TableColumn fx:id="colRiwayatId" prefWidth="130.0" text="ID Mesin" />
                                                    <TableColumn fx:id="colRiwayatTanggal" prefWidth="140.0" text="Tanggal" />
                                                    <TableColumn fx:id="colRiwayatKeterangan" prefWidth="200.0" text="Keterangan" />
                                                </columns>
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                </columnResizePolicy>
                                            </TableView>

                                            <!-- Riwayat Footer -->
                                            <HBox alignment="CENTER_LEFT" styleClass="riwayat-card-footer">
                                                <padding><Insets bottom="12.0" left="20.0" right="20.0" top="12.0" /></padding>
                                                <children>
                                                    <Label styleClass="riwayat-footer-text" text="STATUS:" />
                                                    <Label styleClass="riwayat-footer-status" text=" Aman">
                                                        <HBox.margin><Insets left="4.0" /></HBox.margin>
                                                    </Label>
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <HBox alignment="CENTER" spacing="4.0">
                                                        <children>
                                                            <Rectangle arcHeight="10.0" arcWidth="10.0" fill="#4ADE80" height="12.0" width="4.0" />
                                                            <Rectangle arcHeight="10.0" arcWidth="10.0" fill="#4ADE80" height="12.0" width="4.0" />
                                                            <Rectangle arcHeight="10.0" arcWidth="10.0" fill="#4ADE80" height="12.0" width="4.0" />
                                                            <Rectangle arcHeight="10.0" arcWidth="10.0" fill="#4ADE80" height="12.0" width="4.0" />
                                                        </children>
                                                    </HBox>
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </content>
    </ScrollPane>

</AnchorPane>