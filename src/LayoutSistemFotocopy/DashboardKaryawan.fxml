<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane styleClass="dashboard-bg" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SistemFotocopy.DashboardKaryawan">

    <stylesheets>
        <URL value="@../css/DashboardKaryawan.css" />
    </stylesheets>

    <!-- CONTENT -->
    <VBox alignment="TOP_CENTER" maxWidth="1111.0" prefHeight="661.0" prefWidth="946.0" spacing="16.0" styleClass="dashboard-container">
        <padding>
            <Insets bottom="24.0" left="0.0" right="0.0" top="16.0" />
        </padding>

        <children>

            <!-- ===== ROW 1: SALDO KAS + PENDAPATAN & PENGELUARAN ===== -->
            <HBox alignment="CENTER_LEFT" spacing="0.0" styleClass="card-top-wrapper">
                <children>

                    <!-- SALDO KAS UNIT (kiri, ~55%) -->
                    <VBox alignment="CENTER_LEFT" spacing="12.0" styleClass="card-saldo" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
                        </padding>
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="0.0">
                                <children>
                                    <Label styleClass="saldo-label" text="SALDO KAS UNIT" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <!-- Wallet icon placeholder -->
                                    <StackPane styleClass="saldo-icon-bg">
                                        <children>
                                            <Rectangle arcHeight="6.0" arcWidth="6.0" fill="rgba(244,255,252,0.85)" height="16.0" width="20.0" />
                                        </children>
                                    </StackPane>
                                </children>
                            </HBox>
                            <HBox alignment="BASELINE_LEFT" spacing="8.0">
                                <children>
                                    <Label fx:id="Saldo" styleClass="saldo-amount" text="Rp. 0" />
                                    <Label styleClass="saldo-currency" text="IDR" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <!-- DIVIDER VERTIKAL HIJAU -->
                    <Region prefWidth="4.0" styleClass="vertical-divider-green" />

                    <!-- PENDAPATAN & PENGELUARAN (kanan) -->
                    <HBox alignment="CENTER" spacing="0.0" HBox.hgrow="SOMETIMES">
                        <children>

                            <!-- Pendapatan -->
                            <VBox alignment="TOP_LEFT" spacing="8.0" styleClass="card-stat-pendapatan" HBox.hgrow="ALWAYS">
                                <padding>
                                    <Insets bottom="28.0" left="28.0" right="16.0" top="28.0" />
                                </padding>
                                <children>
                                    <StackPane alignment="CENTER" styleClass="icon-circle-green">
                                        <children>
                                            <Rectangle arcHeight="10.0" arcWidth="10.0" fill="#00685F" height="10.0" width="16.0" />
                                        </children>
                                    </StackPane>
                                    <Label styleClass="stats-label" text="Pendapatan" />
                                    <Label fx:id="Pendapatan" styleClass="stats-amount" text="Rp. 0" />
                                    <HBox alignment="CENTER_LEFT" spacing="4.0">
                                        <children>
                                            <Label styleClass="stats-change-label-green" text="↑ 0% from last month" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                            <!-- Divider tipis antar stat -->
                            <Region prefWidth="1.0" styleClass="vertical-divider-light" />

                            <!-- Pengeluaran -->
                            <VBox alignment="TOP_LEFT" spacing="8.0" styleClass="card-stat-pengeluaran" HBox.hgrow="ALWAYS">
                                <padding>
                                    <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                                </padding>
                                <children>
                                    <StackPane alignment="CENTER" styleClass="icon-circle-red">
                                        <children>
                                            <Rectangle arcHeight="10.0" arcWidth="10.0" fill="#BA1A1A" height="10.0" width="16.0" />
                                        </children>
                                    </StackPane>
                                    <Label styleClass="stats-label" text="Pengeluaran" />
                                    <Label fx:id="Pengeluaran" styleClass="stats-amount" text="Rp. 0" />
                                    <HBox alignment="CENTER_LEFT" spacing="4.0">
                                        <children>
                                            <Label styleClass="stats-change-label-red" text="↓ 0% from last month" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>

                        </children>
                    </HBox>

                </children>
            </HBox>

            <!-- ===== ROW 2: GRAFIK + STATUS MESIN ===== -->
            <HBox alignment="TOP_CENTER" spacing="16.0" styleClass="bottom-row" VBox.vgrow="ALWAYS">
                <children>

                    <!-- GRAFIK PENJUALAN HARIAN (kiri besar) -->
                    <VBox alignment="CENTER_LEFT" spacing="20.0" styleClass="card-chart" HBox.hgrow="ALWAYS">
                        <padding>
                            <Insets bottom="28.0" left="32.0" right="32.0" top="28.0" />
                        </padding>
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="0.0" styleClass="chart-header">
                                <children>
                                    <VBox alignment="CENTER_LEFT" spacing="2.0">
                                        <children>
                                            <Label styleClass="chart-title" text="Grafik Penjualan Harian" />
                                            <Label styleClass="chart-subtitle" text="Performance metrics for the current year" />
                                        </children>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <StackPane styleClass="year-selector">
                                        <children>
                                            <HBox alignment="CENTER" spacing="6.0">
                                                <children>
                                                    <Label styleClass="year-selector-text" text="2026" />
                                                    <Rectangle arcHeight="2.0" arcWidth="2.0" fill="#515F74" height="5.0" width="9.0" />
                                                </children>
                                            </HBox>
                                        </children>
                                    </StackPane>
                                </children>
                            </HBox>

                            <!-- Chart Area Placeholder -->
                            <StackPane styleClass="chart-area" VBox.vgrow="ALWAYS">
                                <children>
                                    <VBox alignment="BOTTOM_CENTER" spacing="0.0" styleClass="chart-bars">
                                        <children>
                                 <BarChart fx:id="ChartPenjualan">
                                   <xAxis>
                                     <CategoryAxis side="BOTTOM" />
                                   </xAxis>
                                   <yAxis>
                                     <NumberAxis side="LEFT" />
                                   </yAxis>
                                 </BarChart>
                                            <HBox alignment="BOTTOM_CENTER" spacing="8.0" styleClass="chart-bars-container">
                                                <padding>
                                                    <Insets bottom="0.0" left="8.0" right="8.0" top="8.0" />
                                                </padding>
                                                <children>
                                                    <Region prefHeight="0.0" styleClass="chart-bar" />
                                                </children>
                                            </HBox>
                                            <StackPane styleClass="chart-grid" />
                                        </children>
                                    </VBox>
                                </children>
                            </StackPane>

                            <!-- Legend -->
                            <HBox alignment="CENTER" spacing="28.0" styleClass="chart-legend">
                                <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Rectangle arcHeight="9999.0" arcWidth="9999.0" fill="#1957A0" height="10.0" width="10.0" />
                                            <Label styleClass="legend-label" text="Current Period" />
                                        </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <children>
                                            <Rectangle arcHeight="9999.0" arcWidth="9999.0" fill="#A0AABF" height="10.0" width="10.0" />
                                            <Label styleClass="legend-label" text="Previous Period" />
                                        </children>
                                    </HBox>
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <!-- STATUS MESIN (kanan) -->
                    <VBox alignment="TOP_LEFT" prefWidth="260.0" spacing="20.0" styleClass="card-status">
                        <padding>
                            <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
                        </padding>
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="0.0" styleClass="status-header">
                                <children>
                                    <Label styleClass="status-title" text="Status Mesin" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label styleClass="status-view-all" text="View All" />
                                </children>
                            </HBox>
                            <VBox fx:id="StatusMesin" alignment="CENTER_LEFT" spacing="12.0" styleClass="status-list" VBox.vgrow="ALWAYS" />
                        </children>
                    </VBox>

                </children>
            </HBox>

        </children>
    </VBox>

</StackPane>
