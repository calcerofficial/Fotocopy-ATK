<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" prefHeight="1355.0" prefWidth="1280.0" styleClass="root-bg" stylesheets="@../css/DataSupplier.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="SistemFotocopy.DataSupplier">

    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll">
            <content>
                <VBox spacing="24.0" styleClass="content-wrapper">
                    <padding>
                        <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
                    </padding>

                    <!-- HEADER + STAT CARDS -->
                    <VBox spacing="32.0" styleClass="card-panel">
                        <Label styleClass="page-title" text="Data Supplier" />

                        <HBox spacing="24.0">
                            <HBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="stat-label" text="TOTAL SUPPLIER" />
                                    <Label fx:id="lblTotalSupplier" styleClass="stat-value" text="0" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="stat-icon" text="🤝" />
                            </HBox>

                            <HBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="stat-label" text="SUPPLIER AKTIF" />
                                    <Label fx:id="lblSupplierAktif" styleClass="stat-value" text="0" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="stat-icon" text="🏢" />
                            </HBox>

                            <HBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="stat-label" text="SUPPLIER NONAKTIF" />
                                    <Label fx:id="lblSupplierNonaktif" styleClass="stat-value-dark" text="0" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label styleClass="stat-icon-muted" text="🏢" />
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- FORM PANEL -->
                    <VBox spacing="0.0" styleClass="form-panel">
                        <padding>
                            <Insets bottom="32.0" left="40.0" right="40.0" top="32.0" />
                        </padding>

                        <GridPane hgap="48.0" vgap="16.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>

                            <!-- KOLOM KIRI -->
                            <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="ID SUPPLIER" />
                                <TextField fx:id="txtIdSupplier" disable="true" styleClass="text-field-disabled" />
                                <Label styleClass="field-hint" text="ID di-isi otomatis oleh sistem" />
                            </VBox>

                            <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <Label styleClass="field-label" text="NAMA SUPPLIER" />
                                <TextField fx:id="txtNamaSupplier" promptText="Masukan Nama lengkap..." styleClass="text-field" />
                                <Label fx:id="lblErrorNama" managed="false" styleClass="error-label" text="" visible="false" />
                            </VBox>

                            <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <Label styleClass="field-label" text="EMAIL" />
                                <TextField fx:id="txtEmail" promptText="Masukan Email...." styleClass="text-field" />
                                <Label fx:id="lblErrorEmail" managed="false" styleClass="error-label" text="" visible="false" />
                            </VBox>

                            <VBox spacing="8.0" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                <Label styleClass="field-label" text="NOMOR TELEPON" />
                                <TextField fx:id="txtNomorTelepon" promptText="Masukan Nomer telepon..." styleClass="text-field" />
                                <Label fx:id="lblErrorTelepon" managed="false" styleClass="error-label" text="" visible="false" />
                            </VBox>

                            <!-- KOLOM KANAN -->
                            <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label styleClass="field-label" text="ALAMAT LENGKAP" />
                                <TextArea fx:id="txtAlamatLengkap" prefRowCount="3" promptText="Masukkan alamat domisili..." styleClass="text-area" wrapText="true" />
                                <Label fx:id="lblErrorAlamat" managed="false" styleClass="error-label" text="" visible="false" />
                            </VBox>

                            <!-- STATUS DIHAPUS DARI SINI -->
                        </GridPane>
                    </VBox>

                    <!-- TOMBOL AKSI + PENCARIAN -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Button fx:id="btnSimpan" onAction="#handleSimpanData" styleClass="btn-primary" text="💾 Simpan Data" />
                        <Button fx:id="btnUbah" onAction="#handleUbahData" styleClass="btn-primary" text="✏ Ubah Data" />
                        <Button fx:id="btnHapus" onAction="#handleHapusData" styleClass="btn-danger" text="🗑 Hapus Data" />
                        <Button fx:id="btnBatal" onAction="#handleBatal" styleClass="btn-primary" text="Batal" />
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="txtCari" promptText="🔍 Cari Berdasarkan nama......" styleClass="search-field" />
                    </HBox>

                    <!-- TABEL DATA -->
                    <VBox styleClass="table-panel">
                        <TableView fx:id="tblSupplier" styleClass="table-pegawai" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colIdSupplier" prefWidth="130.0" text="ID SUPPLIER" />
                                <TableColumn fx:id="colNamaSupplier" prefWidth="160.0" text="NAMA SUPPLIER" />
                                <TableColumn fx:id="colAlamat" prefWidth="170.0" text="          ALAMAT" />
                                <TableColumn fx:id="colNoTelepon" prefWidth="140.0" text="        NO_TELEPON" />
                                <TableColumn fx:id="colEmail" prefWidth="170.0" text="           EMAIL" />
                                <TableColumn fx:id="colStatus" prefWidth="110.0" text="           STATUS" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" styleClass="pagination-bar">
                            <Label fx:id="lblInfoData" styleClass="pagination-info" text="Menampilkan 0 dari 0 data" />
                            <Region HBox.hgrow="ALWAYS" />
                            <HBox alignment="CENTER" spacing="8.0">
                                <Button fx:id="btnPrevPage" onAction="#handlePrevPage" styleClass="pagination-btn" text="&lt;" />
                                <Button fx:id="btnPage1" styleClass="pagination-btn-active" text="1" />
                                <Button fx:id="btnNextPage" onAction="#handleNextPage" styleClass="pagination-btn" text="&gt;" />
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- FOOTER -->
                    <AnchorPane styleClass="footer-panel">
                        <HBox alignment="CENTER_LEFT" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                            <Label styleClass="footer-copyright" text="© 2025 COPYSTREAM PROFESSIONAL SERVICES | ENTERPRISE BUILD V4.2.1" />
                            <Region HBox.hgrow="ALWAYS" />
                            <HBox spacing="24.0">
                                <Label styleClass="footer-link" text="PRIVACY PROTOCOL" />
                                <Label styleClass="footer-link" text="COMPLIANCE HUB" />
                                <Label styleClass="footer-link" text="SYSTEM SUPPORT" />
                            </HBox>
                        </HBox>
                    </AnchorPane>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
